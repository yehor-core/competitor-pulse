# Copy to .env for local runs. docker compose sets its own values for these (see docker-compose.yml).
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://competitor_pulse:competitor_pulse@localhost:5432/competitor_pulse
# Base URL of the listing source. Point it at any other instance.
SOURCE_BASE_URL=http://localhost:4002
# Timeout for every request to the source. The provided source can hold a request open for 8 s.
SOURCE_TIMEOUT_MS=10000
# Requests per second to the source across all competitors. Keep it below the source's own limit (5 for the provided one).
SOURCE_REQUESTS_PER_SECOND=4
# OpenAI Chat Completions compatible endpoint. The mock LLM accepts any key.
LLM_BASE_URL=http://localhost:4001/v1
LLM_API_KEY=mock-key
LLM_MODEL=mock-llm
# Timeout for one LLM call. A slower answer leaves the Summary as llm_timeout; the Snapshot is kept.
LLM_TIMEOUT_MS=20000
# Hard limit of LLM calls per UTC day. It survives restarts; it is kept in Postgres.
LLM_DAILY_CAP=2000
# The UTC day is split into this many windows; each adds its share of the cap and unused share carries over.
# 24 is the Hourly allowance (cap / 24 per hour); 1 turns spreading off.
LLM_BUDGET_WINDOWS_PER_DAY=24
# How often each competitor is polled.
POLL_INTERVAL_SECONDS=900
# How often the scheduler looks for Competitors that are due, and how many Polls it runs at once.
SCHEDULER_TICK_MS=1000
POLL_MAX_IN_FLIGHT=4
# Grafana admin password for docker compose. The default `admin` is for local use only.
# The production override (docker-compose.prod.yml) refuses to start without it.
# GRAFANA_ADMIN_PASSWORD=admin
# Production override only: the hostname Caddy serves over HTTPS (or `:80` for plain HTTP).
# SITE_ADDRESS=v2202608404314505910.hotsrv.de
