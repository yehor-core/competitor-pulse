# Copy to .env for local runs. docker compose sets its own values for these (see docker-compose.yml).
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://competitor_pulse:competitor_pulse@localhost:5432/competitor_pulse
# Base URL of the listing source. Point it at any other instance.
SOURCE_BASE_URL=http://localhost:4002
# Timeout for every request to the source. The provided source can hold a request open for 8 s.
SOURCE_TIMEOUT_MS=10000
# OpenAI Chat Completions compatible endpoint. The mock LLM accepts any key.
LLM_BASE_URL=http://localhost:4001/v1
LLM_API_KEY=mock-key
LLM_MODEL=mock-llm
# How often each competitor is polled.
POLL_INTERVAL_SECONDS=900
# How often the scheduler looks for Competitors that are due, and how many Polls it runs at once.
SCHEDULER_TICK_MS=1000
POLL_MAX_IN_FLIGHT=4
